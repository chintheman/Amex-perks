{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/amex-platinum-guide/benefits-data.schema.json",
  "title": "Amex Platinum Guide — benefits data (v2)",
  "description": "Static data file for the Singapore Amex Platinum benefits guide. Derived values (composite score, grade, annual value, net price, one-line summary) are NOT stored — guide-core.js computes them at load. Absent means absent: null is never a legal value.",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "card",
    "scoring",
    "taxonomy",
    "payback_path",
    "scenarios",
    "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "generated_at": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "next_refresh": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "refresh_days": {
      "type": "integer",
      "minimum": 1
    },
    "card": {
      "type": "object",
      "required": [
        "name",
        "annual_fee_sgd"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "[A-Za-z0-9]"
        },
        "annual_fee_sgd": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "scoring": {
      "type": "object",
      "required": [
        "weights"
      ],
      "additionalProperties": false,
      "properties": {
        "weights": {
          "type": "object",
          "required": [
            "value",
            "accessibility"
          ],
          "additionalProperties": false,
          "properties": {
            "value": {
              "type": "number"
            },
            "accessibility": {
              "type": "number"
            }
          }
        },
        "formula": {
          "type": "string",
          "minLength": 1,
          "pattern": "[A-Za-z0-9]"
        },
        "occasion_note": {
          "type": "string",
          "minLength": 1,
          "pattern": "[A-Za-z0-9]"
        }
      }
    },
    "taxonomy": {
      "type": "object",
      "required": [
        "categories",
        "value_types",
        "sections",
        "tier_groups",
        "tiers",
        "occasions",
        "grade_bands",
        "kinds",
        "efforts"
      ],
      "additionalProperties": false,
      "properties": {
        "categories": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              }
            }
          }
        },
        "value_types": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "definition": {
                "type": "string",
                "minLength": 1,
                "pattern": "[A-Za-z0-9]"
              }
            }
          }
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "chip": {
                "type": "string",
                "minLength": 1,
                "pattern": "[A-Za-z0-9]"
              },
              "desc": {
                "type": "string",
                "minLength": 1,
                "pattern": "[A-Za-z0-9]"
              },
              "default_subcategory": {
                "type": "string",
                "minLength": 1,
                "pattern": "[A-Za-z0-9]"
              }
            }
          }
        },
        "tier_groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "desc": {
                "type": "string",
                "minLength": 1,
                "pattern": "[A-Za-z0-9]"
              }
            }
          }
        },
        "tiers": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "object",
            "required": [
              "label",
              "group"
            ],
            "additionalProperties": false,
            "properties": {
              "label": {
                "type": "string",
                "minLength": 1,
                "pattern": "[A-Za-z0-9]"
              },
              "group": {
                "enum": [
                  "fine",
                  "upscale",
                  "casual",
                  "buffet",
                  "hightea",
                  "bar",
                  "other"
                ]
              }
            }
          }
        },
        "occasions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "desc": {
                "type": "string",
                "minLength": 1,
                "pattern": "[A-Za-z0-9]"
              }
            }
          }
        },
        "kinds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "desc": {
                "type": "string",
                "minLength": 1,
                "pattern": "[A-Za-z0-9]"
              }
            }
          }
        },
        "efforts": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "key",
              "label"
            ],
            "additionalProperties": false,
            "properties": {
              "key": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "desc": {
                "type": "string",
                "minLength": 1,
                "pattern": "[A-Za-z0-9]"
              }
            }
          }
        },
        "grade_bands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "grade",
              "min"
            ],
            "additionalProperties": false,
            "properties": {
              "grade": {
                "enum": [
                  "A+",
                  "A",
                  "B+",
                  "B",
                  "C",
                  "D"
                ]
              },
              "min": {
                "type": "number",
                "minimum": 0,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "caveats": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "[A-Za-z0-9]"
      }
    },
    "payback_path": {
      "type": "object",
      "required": [
        "steps"
      ],
      "additionalProperties": false,
      "properties": {
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "ref"
            ],
            "additionalProperties": false,
            "properties": {
              "ref": {
                "type": "string",
                "pattern": "^[a-z0-9][a-z0-9-]*$"
              },
              "uses": {
                "type": "integer",
                "minimum": 1
              },
              "split": {
                "const": true
              },
              "condition": {
                "type": "string",
                "minLength": 1,
                "pattern": "[A-Za-z0-9]"
              }
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/scenario"
      }
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "required": [
        "id",
        "name",
        "kind",
        "category",
        "section",
        "value_type",
        "effort",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "[A-Za-z0-9]"
        },
        "kind": {
          "enum": [
            "benefit",
            "venue"
          ]
        },
        "parent": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "effort": {
          "enum": [
            "claim",
            "book",
            "have"
          ]
        },
        "category": {
          "enum": [
            "dining",
            "lifestyle"
          ]
        },
        "section": {
          "enum": [
            "ldr",
            "ldh",
            "promo",
            "progs",
            "life"
          ]
        },
        "subcategory": {
          "type": "string",
          "minLength": 1,
          "pattern": "[A-Za-z0-9]"
        },
        "value_type": {
          "enum": [
            "discount",
            "free",
            "credit",
            "access"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "pattern": "[A-Za-z0-9]",
          "maxLength": 240
        },
        "details": {
          "type": "string",
          "minLength": 1,
          "pattern": "[A-Za-z0-9]"
        },
        "venue": {
          "$ref": "#/$defs/venue"
        },
        "economics": {
          "$ref": "#/$defs/economics"
        },
        "scores": {
          "$ref": "#/$defs/scores"
        },
        "occasion_fit": {
          "$ref": "#/$defs/occasionFit"
        },
        "terms": {
          "$ref": "#/$defs/terms"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          }
        },
        "source": {
          "type": "string",
          "pattern": "^https://[^\\s]+$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "venue"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "parent"
            ]
          },
          "else": {
            "properties": {
              "parent": false
            }
          }
        },
        {
          "if": {
            "properties": {
              "category": {
                "const": "lifestyle"
              }
            },
            "required": [
              "category"
            ]
          },
          "then": {
            "properties": {
              "section": {
                "const": "life"
              }
            }
          },
          "else": {
            "properties": {
              "section": {
                "enum": [
                  "ldr",
                  "ldh",
                  "promo",
                  "progs"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value_type": {
                "const": "access"
              }
            },
            "required": [
              "value_type"
            ]
          },
          "then": {
            "properties": {
              "economics": false,
              "scores": false
            },
            "required": [
              "summary",
              "details"
            ]
          },
          "else": {
            "required": [
              "scores",
              "economics"
            ]
          }
        }
      ]
    },
    "scenario": {
      "type": "object",
      "required": [
        "key",
        "label",
        "blurb"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "pattern": "[A-Za-z0-9]"
        },
        "blurb": {
          "type": "string",
          "minLength": 1,
          "pattern": "[A-Za-z0-9]"
        },
        "sort": {
          "type": "string"
        },
        "view": {
          "enum": [
            "year"
          ]
        },
        "filter": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": false,
          "properties": {
            "kind": {
              "enum": [
                "benefit",
                "venue"
              ]
            },
            "effort": {
              "enum": [
                "claim",
                "book",
                "have"
              ]
            },
            "section": {
              "enum": [
                "ldr",
                "ldh",
                "promo",
                "progs",
                "life"
              ]
            },
            "sections": {
              "type": "array",
              "items": {
                "enum": [
                  "ldr",
                  "ldh",
                  "promo",
                  "progs",
                  "life"
                ]
              }
            },
            "value_type": {
              "enum": [
                "discount",
                "free",
                "credit",
                "access"
              ]
            },
            "value_types": {
              "type": "array",
              "items": {
                "enum": [
                  "discount",
                  "free",
                  "credit",
                  "access"
                ]
              }
            },
            "tier_groups": {
              "type": "array",
              "items": {
                "enum": [
                  "fine",
                  "upscale",
                  "casual",
                  "buffet",
                  "hightea",
                  "bar",
                  "other"
                ]
              }
            },
            "subcategories": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "pattern": "[A-Za-z0-9]"
              }
            },
            "occasion": {
              "enum": [
                "date_night",
                "business",
                "free_treat"
              ]
            },
            "min_occasion_fit": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "max_min_spend": {
              "type": "number",
              "minimum": 0
            },
            "has_expiry": {
              "const": true
            }
          }
        }
      },
      "oneOf": [
        {
          "required": [
            "filter"
          ]
        },
        {
          "required": [
            "view"
          ]
        }
      ]
    },
    "venue": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "string",
          "minLength": 1,
          "pattern": "[A-Za-z0-9]"
        },
        "cuisine": {
          "type": "string",
          "minLength": 1,
          "pattern": "[A-Za-z0-9]"
        },
        "tier": {
          "enum": [
            "ultra",
            "fine",
            "upscale",
            "mid",
            "casual",
            "cafe",
            "buffet",
            "buffet_premium",
            "high_tea",
            "bar",
            "credit"
          ]
        },
        "tier_group": {
          "enum": [
            "fine",
            "upscale",
            "casual",
            "buffet",
            "hightea",
            "bar",
            "other"
          ]
        },
        "pax": {
          "type": "integer",
          "minimum": 1
        },
        "fixed_set": {
          "const": true
        },
        "set_price_sgd": {
          "type": "number",
          "minimum": 0
        }
      },
      "dependentRequired": {
        "tier": [
          "tier_group"
        ],
        "tier_group": [
          "tier"
        ],
        "set_price_sgd": [
          "fixed_set"
        ]
      }
    },
    "economics": {
      "type": "object",
      "required": [
        "min_spend_sgd",
        "gross_value_sgd"
      ],
      "additionalProperties": false,
      "properties": {
        "min_spend_sgd": {
          "type": "number",
          "minimum": 0
        },
        "gross_value_sgd": {
          "type": "number",
          "minimum": 0
        },
        "discount_pct": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "min_spend_to_activate": {
          "type": "number",
          "minimum": 0
        },
        "credit_value_sgd": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "scores": {
      "type": "object",
      "required": [
        "value",
        "accessibility"
      ],
      "additionalProperties": false,
      "properties": {
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "accessibility": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "occasionFit": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "date_night": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "business": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "free_treat": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "terms": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "annual_cap": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "advance": {
          "type": "string",
          "minLength": 1,
          "pattern": "[A-Za-z0-9]"
        },
        "condition": {
          "type": "string",
          "minLength": 1,
          "pattern": "[A-Za-z0-9]"
        },
        "third_party_barred": {
          "type": "boolean"
        },
        "expires": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "location": {
      "type": "object",
      "required": [
        "name",
        "lat",
        "lng"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "pattern": "[A-Za-z0-9]"
        },
        "lat": {
          "type": "number",
          "minimum": 1.13,
          "maximum": 1.52
        },
        "lng": {
          "type": "number",
          "minimum": 103.55,
          "maximum": 104.12
        },
        "address": {
          "type": "string",
          "minLength": 1,
          "pattern": "[A-Za-z0-9]"
        }
      }
    }
  }
}
